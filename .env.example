# Copier ce fichier en ".env" et renseigner des valeurs locales.
# Aucun secret réel ne doit être commité.

# Environnement actif : dev | qa | prod (obligatoire, pas de défaut : le
# service refuse de démarrer si cette variable est absente ou invalide).
APP_ENV=dev

# Chaîne de connexion PostgreSQL, dédiée à cet environnement.
DATABASE_URL=postgresql+psycopg://rps:rps@localhost:5432/rps_dev

# Niveau de log (optionnel, défaut : INFO).
LOG_LEVEL=DEBUG

# Port d'écoute du service (optionnel, défaut : 8080).
APP_PORT=8080
